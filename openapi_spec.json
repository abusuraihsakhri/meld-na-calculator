{
  "openapi": "3.1.0",
  "info": {
    "title": "MELD Reference Calculator API",
    "description": "Educational MELD, MELD-Na (2016), and adult MELD 3.0 calculations. Not an official allocation system.",
    "version": "1.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Status JSON"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-process audit counters",
        "responses": {
          "200": {
            "description": "Counters JSON; not Prometheus format"
          }
        }
      }
    },
    "/api/calculate": {
      "post": {
        "summary": "Calculate scores from positive lab inputs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bilirubin",
                  "inr",
                  "creatinine",
                  "sodium"
                ],
                "properties": {
                  "bilirubin": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mg/dL"
                  },
                  "inr": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "creatinine": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mg/dL"
                  },
                  "sodium": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mEq/L"
                  },
                  "albumin": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "exclusiveMinimum": 0,
                    "description": "g/dL; required for MELD 3.0"
                  },
                  "female": {
                    "type": "boolean",
                    "default": false
                  },
                  "dialysis": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference score calculations and applied caps"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy rule-based audit demo (not clinical MELD evaluation)",
        "responses": {
          "200": {
            "description": "In-memory audit dossier"
          },
          "400": {
            "description": "Recognized identifier blocked"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic placeholder (not an LLM)",
        "responses": {
          "200": {
            "description": "Placeholder response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory HMAC audit trail and integrity check",
        "responses": {
          "200": {
            "description": "Entries and verification flag"
          }
        }
      }
    }
  }
}
